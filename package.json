{
  "name": "shopify-seo-crawler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "crawl": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/urlUtils.test.ts tests/duplicateDetector.test.ts tests/fetchFailureClassifier.test.ts tests/crawlStatsReport.test.ts tests/indexability.test.ts"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "cheerio": "^1.2.0",
    "p-queue": "^9.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.20.2",
    "typescript": "^5.8.3"
  }
}
